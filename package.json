{
  "name": "vrun",
  "displayName": "vrun",
  "description": "Persistent Python kernel for .py files with a variable explorer, large-DataFrame viewer and real-time data-structure & algorithm visualizer.",
  "version": "0.3.0",
  "publisher": "vrun-local",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Data Science", "Visualization", "Education", "Other"],
  "keywords": ["python", "pandas", "dataframe", "variable explorer", "algorithm visualizer"],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:python"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "vrun executes Python code from the workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      { "command": "vrun.startKernel", "title": "Start Kernel", "category": "vrun" },
      { "command": "vrun.restartKernel", "title": "Restart Kernel", "category": "vrun", "icon": "$(debug-restart)" },
      { "command": "vrun.stopKernel", "title": "Stop Kernel", "category": "vrun", "icon": "$(debug-stop)" },
      { "command": "vrun.runSelection", "title": "Run Selection", "category": "vrun" },
      { "command": "vrun.runCell", "title": "Run Cell", "category": "vrun", "icon": "$(play-circle)" },
      { "command": "vrun.runFile", "title": "Run File", "category": "vrun", "icon": "$(run-all)" },
      { "command": "vrun.toggleLiveMode", "title": "Toggle Live Mode", "category": "vrun" },
      { "command": "vrun.visualize", "title": "Visualize Algorithm (step-by-step trace)", "category": "vrun", "icon": "$(graph)" },
      { "command": "vrun.toggleLiveVisualize", "title": "Toggle Live Visualize (DSA)", "category": "vrun" },
      { "command": "vrun.openVariables", "title": "Open Variable Explorer", "category": "vrun" },
      { "command": "vrun.openDataFrame", "title": "Open DataFrame Viewer", "category": "vrun" },
      { "command": "vrun.interrupt", "title": "Interrupt Execution", "category": "vrun", "icon": "$(debug-pause)" },
      { "command": "vrun.showLog", "title": "Show Kernel Log", "category": "vrun" },
      { "command": "vrun.clearInlineResults", "title": "Clear Inline Results", "category": "vrun" },
      { "command": "vrun.editInput", "title": "Edit Program Input (stdin)", "category": "vrun" },
      { "command": "vrun.newPracticeFile", "title": "New Practice File (ML, pandas, algorithms)", "category": "vrun" }
    ],
    "snippets": [
      { "language": "python", "path": "./snippets/python.json" }
    ],
    "keybindings": [
      { "command": "vrun.runSelection", "key": "ctrl+alt+enter", "mac": "cmd+alt+enter", "when": "editorTextFocus && editorLangId == python" },
      { "command": "vrun.runCell", "key": "ctrl+alt+c", "mac": "cmd+alt+c", "when": "editorTextFocus && editorLangId == python" },
      { "command": "vrun.visualize", "key": "ctrl+alt+v", "mac": "cmd+alt+v", "when": "editorTextFocus && editorLangId == python" },
      { "command": "vrun.interrupt", "key": "ctrl+alt+i", "mac": "cmd+alt+i", "when": "editorLangId == python" }
    ],
    "menus": {
      "editor/title": [
        { "command": "vrun.runCell", "when": "editorLangId == python", "group": "navigation@1" },
        { "command": "vrun.visualize", "when": "editorLangId == python && config.vrun.features.visualizer", "group": "navigation@2" }
      ],
      "editor/context": [
        { "command": "vrun.runSelection", "when": "editorLangId == python && editorHasSelection", "group": "pylive@1" },
        { "command": "vrun.runCell", "when": "editorLangId == python", "group": "pylive@2" },
        { "command": "vrun.visualize", "when": "editorLangId == python && config.vrun.features.visualizer", "group": "pylive@3" }
      ]
    },
    "configuration": {
      "title": "vrun",
      "properties": {
        "vrun.features.visualizer": {
          "type": "boolean",
          "default": false,
          "order": 0,
          "description": "Show the algorithm visualizer (DSA) tab: step-by-step traces with arrays, number lines, graphs, trees and linked lists."
        },
        "vrun.features.dataframe": {
          "type": "boolean",
          "default": false,
          "order": 1,
          "description": "Show the DataFrame viewer tab for paging, sorting and filtering pandas DataFrames."
        },
        "vrun.inlineResults": {
          "type": "string",
          "enum": ["values", "off"],
          "enumDescriptions": [
            "Show an expression's value or an error at the end of the code that ran.",
            "Never write results into the editor (they stay in the Output tab)."
          ],
          "default": "values",
          "order": 2,
          "description": "Results shown inline in the editor after a run. Notes disappear when you edit their line."
        },
        "vrun.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Python interpreter for the kernel. Empty: use the Python extension's selected interpreter, then `python` on PATH."
        },
        "vrun.live.debounceMs": {
          "type": "number", "default": 800, "minimum": 150, "maximum": 10000,
          "description": "Delay after the last edit before Live Mode re-runs code."
        },
        "vrun.live.timeoutMs": {
          "type": "number", "default": 5000, "minimum": 200, "maximum": 120000,
          "description": "Time budget for one live run. The kernel is interrupted when it is exceeded."
        },
        "vrun.interrupt.graceMs": {
          "type": "number", "default": 3000, "minimum": 500, "maximum": 60000,
          "description": "How long to wait for an interrupt before offering to restart the kernel."
        },
        "vrun.dataframe.pageSize": {
          "type": "number", "default": 50, "minimum": 10, "maximum": 500,
          "description": "Rows per DataFrame page."
        },
        "vrun.inspect.timeoutMs": {
          "type": "number", "default": 20000, "minimum": 1000, "maximum": 600000,
          "description": "Time budget for DataFrame summaries and other inspection requests."
        },
        "vrun.trace.maxSteps": {
          "type": "number", "default": 5000, "minimum": 10, "maximum": 50000,
          "description": "Maximum recorded steps for the algorithm visualizer (a sort of 50 numbers takes about 2000)."
        },
        "vrun.trace.timeoutMs": {
          "type": "number", "default": 15000, "minimum": 500, "maximum": 600000,
          "description": "Time budget for one algorithm trace."
        },
        "vrun.safeMl.confirmRepeatTraining": {
          "type": "boolean", "default": true,
          "description": "Ask before re-running a cell that trains a model and already ran in this kernel session."
        },
        "vrun.safeMl.confirmAfterSeconds": {
          "type": "number", "default": 5, "minimum": 0, "maximum": 86400,
          "description": "Only ask before repeating training when its previous run took at least this many seconds (0 = always ask)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p webview --noEmit",
    "test": "npm run build && node esbuild.mjs --tests && node --test --test-concurrency=1 \"out/test/unit/*.test.js\"",
    "test:py": "node scripts/run-pytest.mjs",
    "test:vscode": "npm run build && node esbuild.mjs --tests && node out/test/integration/runTest.js",
    "package": "npm run build -- --production && vsce package --no-dependencies --allow-missing-repository",
    "dist": "node scripts/make-dist.mjs",
    "setup:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "mocha": "^11.1.0",
    "typescript": "^5.7.0"
  }
}
